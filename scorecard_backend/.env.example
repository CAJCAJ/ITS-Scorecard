# Copy this file to .env.local and replace the placeholder values with
# credentials from your own Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Permanent dashboard return links use an RLS-protected table and require a
# private backend key. Never expose this key to frontend code.
SUPABASE_SECRET_KEY=your-secret-key-here

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:2999,https://your-frontend.onrender.com

# Gmail SMTP delivery for permanent dashboard return links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-project-account@gmail.com
SMTP_APP_PASSWORD=your-google-app-password
EMAIL_FROM=ITS Scorecard <your-project-account@gmail.com>
FRONTEND_PUBLIC_URL=http://localhost:2999
RETURN_LINK_SIGNING_SECRET=your-long-random-signing-secret
