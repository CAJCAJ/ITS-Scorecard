# Copy this file to .env.local and replace the placeholder values with
# credentials from your own Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# For production backend deployments, prefer a service-role key stored only
# in the backend host environment. Never expose it to frontend code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:2999,https://your-frontend.onrender.com
